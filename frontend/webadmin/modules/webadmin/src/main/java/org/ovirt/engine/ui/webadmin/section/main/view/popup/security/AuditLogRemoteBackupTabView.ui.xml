<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder
    xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:g="urn:import:com.google.gwt.user.client.ui"
    xmlns:b="urn:import:org.gwtbootstrap3.client.ui">

    <ui:style>
        .mainPanel {
            padding: 20px;
            width: 100%;
        }

        .sectionPanel {
            margin-bottom: 20px;
            padding: 15px;
            border: 1px solid #ddd;
            border-radius: 4px;
        }

        .sectionTitle {
            font-size: 18px;
            font-weight: bold;
            margin-bottom: 15px;
        }

        .sectionDescription {
            color: #666;
            margin-bottom: 10px;
        }

        .inputRow {
            margin-top: 10px;
        }

        .inputLabel {
            margin-right: 8px;
            font-weight: bold;
        }

        .resultLabel {
            margin-top: 10px;
            color: #1f6b8a;
            font-weight: bold;
        }

        .buttonPanel {
            margin-top: 15px;
        }

        .actionButton {
            margin-right: 15px;
        }
    </ui:style>

    <g:FlowPanel addStyleNames="{style.mainPanel}">
        <g:FlowPanel addStyleNames="{style.sectionPanel}">
            <g:HTML addStyleNames="{style.sectionTitle}">감사기록 원격 백업</g:HTML>
            <g:HTML addStyleNames="{style.sectionDescription}">
                원격 서버 주소를 입력하면 rsyslog 설정을 검증·적용하고 서비스를 재시작합니다.
            </g:HTML>
            <g:HorizontalPanel addStyleNames="{style.inputRow}">
                <g:Label addStyleNames="{style.inputLabel}">원격 서버 주소</g:Label>
                <g:TextBox ui:field="remoteBackupAddressInput" width="320px" />
            </g:HorizontalPanel>
            <g:HorizontalPanel addStyleNames="{style.buttonPanel}">
                <b:Button ui:field="remoteBackupButton"
                          text="원격 백업 설정"
                          type="PRIMARY"
                          addStyleNames="{style.actionButton}" />
            </g:HorizontalPanel>
            <g:HTML ui:field="remoteBackupResultLabel" addStyleNames="{style.resultLabel}" />
        </g:FlowPanel>
    </g:FlowPanel>
</ui:UiBinder>
