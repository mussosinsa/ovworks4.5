<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:d="urn:import:org.ovirt.engine.ui.common.widget.dialog"
    xmlns:ge="urn:import:org.ovirt.engine.ui.common.widget.editor.generic"
    xmlns:g="urn:import:com.google.gwt.user.client.ui"
    xmlns:b="urn:import:org.gwtbootstrap3.client.ui">

    <ui:with field='constants' type='org.ovirt.engine.ui.uicompat.UIConstants' />

    <ui:style>
        .errorMessage {
            color: #a94442;
            background-color: #f2dede;
            border: 1px solid #ebccd1;
            border-radius: 4px;
            padding: 10px;
            margin-bottom: 10px;
            white-space: pre-wrap;
        }
        .hint { color: #6a6e73; font-size: 12px; line-height: 1.7; margin: -6px 0 10px; }
        .hintTitle { font-weight: 600; color: #4d5258; display: block; margin-bottom: 2px; }
        .hintList { margin: 0; padding-left: 18px; }
    </ui:style>

    <d:SimpleDialogPanel width="520px" height="380px">
        <d:content>
            <b:Container fluid="true">
                <b:Row>
                    <g:HTML ui:field="messageLabel" addStyleNames="{style.errorMessage}" visible="false"/>
                </b:Row>
                <b:Row>
                    <ge:StringEntityModelPasswordBoxEditor
                        ui:field="passwordEditor"
                        label="{constants.passwordLabel}"
                        usePatternFly="true"
                        labelColSize="SM_4"
                        widgetColSize="SM_8" />
                </b:Row>
                <b:Row>
                    <b:Column size="SM_8" offset="SM_4">
                        <g:HTMLPanel styleName="{style.hint}">
                            <span class="{style.hintTitle}">패스워드 정책</span>
                            <ul class="{style.hintList}">
                                <li>12자리 이상</li>
                                <li>숫자 · 영문 대문자 · 영문 소문자 · 특수문자 각 1개 이상</li>
                                <li>사용자 이름과 동일한 패스워드 금지</li>
                                <li>동일 문자·숫자 3회 이상 연속 반복 금지</li>
                                <li>알파벳·숫자·키보드상 연속된 4자리 금지 (예: abcd, 1234, qwer)</li>
                                <li>직전에 사용한 패스워드 재사용 금지</li>
                                <li>최근 3개월 이내에 사용한 패스워드 재사용 금지</li>
                            </ul>
                        </g:HTMLPanel>
                    </b:Column>
                </b:Row>
            </b:Container>
        </d:content>
    </d:SimpleDialogPanel>

</ui:UiBinder>
