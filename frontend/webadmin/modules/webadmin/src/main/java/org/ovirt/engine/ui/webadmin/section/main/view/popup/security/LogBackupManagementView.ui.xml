<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder
    xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:g="urn:import:com.google.gwt.user.client.ui"
    xmlns:b="urn:import:org.gwtbootstrap3.client.ui">

    <ui:style>
        .mainPanel {
            padding: 20px;
            width: 100%;
        }

        .sectionPanel {
            margin-bottom: 20px;
            padding: 15px;
            border: 1px solid #ddd;
            border-radius: 4px;
        }

        .sectionTitle {
            font-size: 22px;
            font-weight: bold;
            margin-bottom: 15px;
        }

        .buttonPanel {
            margin-top: 10px;
        }

        .actionButton {
            margin-right: 15px;
            width: 100%;
            max-width: 520px;
            background-color: #0f5f7c !important;
            border: 2px solid #0b3e4f !important;
            color: #ffffff !important;
            font-size: 18px;
            padding: 8px 12px;
            border-radius: 2px;
        }
    </ui:style>

    <g:FlowPanel addStyleNames="{style.mainPanel}">
        <g:FlowPanel addStyleNames="{style.sectionPanel}">
            <g:HTML addStyleNames="{style.sectionTitle}">전체 로그 백업</g:HTML>
            <g:HorizontalPanel addStyleNames="{style.buttonPanel}">
                <b:Button ui:field="fullLogBackupButton"
                          text="전체 로그 백업"
                          type="PRIMARY"
                          addStyleNames="{style.actionButton}" />
            </g:HorizontalPanel>
        </g:FlowPanel>
        <g:FlowPanel addStyleNames="{style.sectionPanel}">
            <g:HTML addStyleNames="{style.sectionTitle}">전체 로그 원격 백업</g:HTML>
            <g:HorizontalPanel addStyleNames="{style.buttonPanel}">
                <b:Button ui:field="remoteBackupButton"
                          text="원격 주소(/etc/rsyslog.conf)"
                          type="PRIMARY"
                          addStyleNames="{style.actionButton}" />
            </g:HorizontalPanel>
        </g:FlowPanel>
        <g:FlowPanel addStyleNames="{style.sectionPanel}">
            <g:HTML addStyleNames="{style.sectionTitle}">가용성 확보</g:HTML>
            <g:HorizontalPanel addStyleNames="{style.buttonPanel}">
                <b:Button ui:field="engineBackupButton"
                          text="engine-backup 실행"
                          type="PRIMARY"
                          addStyleNames="{style.actionButton}" />
            </g:HorizontalPanel>
        </g:FlowPanel>
    </g:FlowPanel>
</ui:UiBinder>
