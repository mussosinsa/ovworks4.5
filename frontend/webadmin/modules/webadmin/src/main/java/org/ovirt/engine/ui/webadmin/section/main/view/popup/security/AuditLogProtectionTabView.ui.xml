<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder
    xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:g="urn:import:com.google.gwt.user.client.ui"
    xmlns:b="urn:import:org.gwtbootstrap3.client.ui">

    <ui:style>
        .mainPanel {
            padding: 20px;
            width: 100%;
        }

        .sectionPanel {
            margin-bottom: 20px;
            padding: 15px;
            border: 1px solid #ddd;
            border-radius: 4px;
        }

        .sectionTitle {
            font-size: 18px;
            font-weight: bold;
            margin-bottom: 15px;
        }

        .sectionDescription {
            color: #666;
            margin-bottom: 10px;
        }

        .inputRow {
            margin-top: 10px;
        }

        .inputLabel {
            margin-right: 8px;
            font-weight: bold;
        }

        .resultLabel {
            margin-top: 10px;
            color: #1f6b8a;
            font-weight: bold;
        }

        .buttonPanel {
            margin-top: 15px;
        }

        .actionButton {
            margin-right: 15px;
        }

        .listBox {
            width: 500px;
            height: 180px;
            margin-top: 10px;
        }

        .capacityRow {
            margin-bottom: 10px;
        }

        .capacityState {
            font-weight: bold;
            margin-right: 15px;
            padding: 6px 0;
        }

        /*
            The bar is drawn as two nested boxes rather than with a widget: the fill is a width in
            per cent and the colour is one of three, both of which have to be set from the reading,
            and a widget would have to be told the same two things anyway.
        */
        .capacityGauge {
            background-color: #eeeeee;
            border: 1px solid #ddd;
            border-radius: 4px;
            height: 22px;
            margin-bottom: 10px;
            max-width: 560px;
            overflow: hidden;
        }

        .capacityDetail {
            color: #333;
            line-height: 1.8;
        }
    </ui:style>

    <g:FlowPanel addStyleNames="{style.mainPanel}">
        <!--
            How full the storage holding the audit records is.

            The engine has always watched this and raised an alarm once the space ran short. An
            alarm is what an administrator is told when it is already a problem; there was nothing
            that simply said how full the storage was, so the state could only be waited for. It
            is first on this tab because it is the state of the thing the rest of the tab acts on:
            backing the records up is what an administrator does about a storage that is filling.
        -->
        <g:FlowPanel addStyleNames="{style.sectionPanel}">
            <g:HTML addStyleNames="{style.sectionTitle}">감사기록 저장소 용량</g:HTML>
            <g:HorizontalPanel addStyleNames="{style.capacityRow}">
                <g:Label ui:field="capacityStateLabel" addStyleNames="{style.capacityState}" />
                <b:Button ui:field="refreshCapacityButton"
                          text="용량 새로 고침"
                          type="INFO"
                          addStyleNames="{style.actionButton}" />
            </g:HorizontalPanel>
            <g:HTML ui:field="capacityGaugeLabel" addStyleNames="{style.capacityGauge}" />
            <g:HTML ui:field="capacityDetailLabel" addStyleNames="{style.capacityDetail}" />
        </g:FlowPanel>

        <g:FlowPanel addStyleNames="{style.sectionPanel}">
            <g:HTML addStyleNames="{style.sectionTitle}">감사기록 보호</g:HTML>
            <g:HTML addStyleNames="{style.sectionDescription}">
                이벤트 관련 DB 테이블만 압축 덤프하여 지정한 폴더에 저장합니다.
            </g:HTML>
            <g:HorizontalPanel addStyleNames="{style.inputRow}">
                <g:Label addStyleNames="{style.inputLabel}">저장 위치</g:Label>
                <g:TextBox ui:field="fullLogBackupPathInput" width="320px" />
            </g:HorizontalPanel>
            <g:HorizontalPanel addStyleNames="{style.buttonPanel}">
                <b:Button ui:field="fullLogBackupButton"
                          text="전체 로그 백업"
                          type="PRIMARY"
                          addStyleNames="{style.actionButton}" />
                <b:Button ui:field="refreshBackupListButton"
                          text="감사기록 조회"
                          type="INFO"
                          addStyleNames="{style.actionButton}" />
            </g:HorizontalPanel>

            <g:ListBox ui:field="backupFileListBox" addStyleNames="{style.listBox}" />

            <g:HorizontalPanel addStyleNames="{style.buttonPanel}">
                <b:Button ui:field="restoreSelectedBackupButton"
                          text="복구 (현재 이벤트 백업 후 복구)"
                          type="WARNING"
                          addStyleNames="{style.actionButton}" />
            </g:HorizontalPanel>

            <g:HTML ui:field="fullLogBackupResultLabel" addStyleNames="{style.resultLabel}" />
        </g:FlowPanel>
    </g:FlowPanel>
</ui:UiBinder>
