<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:g="urn:import:com.google.gwt.user.client.ui"
    xmlns:b="urn:import:org.gwtbootstrap3.client.ui">
    <g:HTMLPanel styleName="content-area" width="100%">
        <div style="padding:10px; border:1px solid #2b3f5b; background:#fff; color:#1f2d3d; min-height:520px;">
            <g:VerticalPanel width="100%" spacing="6">
                <g:HTML><div style="padding:10px 14px; border:1px solid #2f6f8c; border-radius:4px; background:linear-gradient(90deg, #155f79 0%, #2f8fa3 100%); color:#fff; font-size:18px; font-weight:600;">사용자 환경 변수 관리</div></g:HTML>
                <g:HTML><div style="font-size:16px; font-weight:600;">사용자 환경 변수 조회</div></g:HTML>
                <g:HorizontalPanel spacing="8" verticalAlignment="ALIGN_MIDDLE" width="100%">
                    <g:TextBox ui:field="keyTextBox" width="720px" />
                    <b:Button ui:field="queryButton" text="조회" icon="REFRESH" />
                </g:HorizontalPanel>
                <g:HTML ui:field="commandLabel"><span style="color:#16658a;">ovirt-aaa-jdbc-tool settings show --name=&lt;NAME&gt;</span></g:HTML>
                <g:ScrollPanel height="145px" width="100%" styleName="form-control">
                    <g:HTML ui:field="outputLabel" />
                </g:ScrollPanel>

                <g:HTML><div style="font-size:16px; font-weight:600; border-bottom:1px solid #ccd5dc; padding-bottom:4px;">구성 결과</div></g:HTML>
                <g:Grid cellSpacing="8" width="100%">
                    <g:row>
                        <g:customCell><g:HTML><strong>Key</strong></g:HTML></g:customCell>
                        <g:customCell><g:HTML><strong>Value</strong></g:HTML></g:customCell>
                        <g:customCell><g:HTML><strong>설명</strong></g:HTML></g:customCell>
                    </g:row>
                    <g:row>
                        <g:customCell><g:HTML ui:field="queriedKeyLabel" /></g:customCell>
                        <g:customCell><g:TextBox ui:field="valueTextBox" width="260px" /></g:customCell>
                        <g:customCell><g:HTML ui:field="descriptionLabel" /></g:customCell>
                    </g:row>
                </g:Grid>
                <b:Button ui:field="updateButton" text="수정" icon="EDIT" />
                <g:HTML><span style="color:#556b7a;">변수 이름을 조회한 후 값을 수정할 수 있습니다. 변경 후 재시작이 필요할 수 있습니다.</span></g:HTML>
                <g:HTML ui:field="resultLabel" />
            </g:VerticalPanel>
        </div>
    </g:HTMLPanel>
</ui:UiBinder>
