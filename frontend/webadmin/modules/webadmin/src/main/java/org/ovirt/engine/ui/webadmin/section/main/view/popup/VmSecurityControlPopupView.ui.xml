<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder
    xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:g="urn:import:com.google.gwt.user.client.ui"
    xmlns:d="urn:import:org.ovirt.engine.ui.common.widget.dialog"
    xmlns:t="urn:import:org.ovirt.engine.ui.common.widget.dialog.tab">

    <ui:with field="constants" type="org.ovirt.engine.ui.webadmin.ApplicationConstants" />

    <ui:style>
        .content { height: 100%; overflow: auto; padding: 18px 20px; box-sizing: border-box; }
        .formRow { margin-bottom: 10px; }
        .formLabel { display: block; font-weight: 600; margin-bottom: 4px; }
        .fullWidth { width: 100%; box-sizing: border-box; }
        .actionRow { margin-top: 14px; }
        .hint { color: #666; margin: 8px 0 12px; }
        .result { width: 100%; min-height: 105px; box-sizing: border-box; font-family: monospace; }
        .hidden { display: none; }
        .columns { display: flex; gap: 32px; }
        .column { flex: 1; min-width: 0; }
        .divider { border-left: 1px solid #ddd; padding-left: 24px; }
        .sectionTitle { background: #edf6fc; font-weight: 700; padding: 4px 6px; margin: 8px 0; }
        .checkRow { display: block; margin: 6px 0; }
        .toolbar { display: flex; gap: 8px; margin-bottom: 10px; }
        .toolbarInput { flex: 1; min-width: 0; }
        .commandTable { table-layout: fixed; width: 100%; }
        .commandColumn { width: 35%; }
        .iconColumn { width: 54px; text-align: center; }
        .eventOk { color: #238b45; }
        .eventWarn { color: #bd8b00; }
    </ui:style>

    <d:SimpleDialogPanel header="{constants.vmSecurityControlTitle}" height="560px" width="880px">
        <d:content>
            <t:DialogTabPanel height="100%" width="100%">
                <t:tab>
                    <t:DialogTab label="{constants.vmSecurityNetworkTab}">
                        <t:content><g:HTMLPanel styleName="{style.content}">
                            <div class="{style.columns}">
                                <div class="{style.column}">
                                    <label class="{style.formLabel}"><ui:text from="{constants.vmSecurityNetworkAdapter}" /></label>
                                    <select class="form-control {style.fullWidth}"><option>Bridged Adapter</option><option>NAT</option><option>Host-only Adapter</option></select>
                                    <h4><ui:text from="{constants.vmSecurityStatusSettings}" /></h4>
                                    <g:CheckBox styleName="{style.checkRow}" text="{constants.vmSecurityDisable}" />
                                    <g:CheckBox styleName="{style.checkRow}" text="{constants.vmSecurityEnableIp}" value="true" />
                                </div>
                                <div class="{style.column} {style.divider}">
                                    <h4><ui:text from="{constants.vmSecurityIpDetails}" /></h4>
                                    <div class="{style.formRow}"><label><ui:text from="{constants.vmSecurityIpAddress}" /></label><g:TextBox styleName="form-control {style.fullWidth}" text="192.168.1.50" /></div>
                                    <div class="{style.formRow}"><label><ui:text from="{constants.vmSecuritySubnetMask}" /></label><g:TextBox styleName="form-control {style.fullWidth}" text="255.255.255.0" /></div>
                                    <div class="{style.formRow}"><label><ui:text from="{constants.vmSecurityGateway}" /></label><g:TextBox styleName="form-control {style.fullWidth}" text="192.168.1.1" /></div>
                                    <div class="{style.formRow}"><label><ui:text from="{constants.vmSecurityDnsServer}" /></label><g:TextBox styleName="form-control {style.fullWidth}" text="8.8.8.8" /></div>
                                    <button class="btn btn-success"><ui:text from="{constants.vmSecurityTestAndSave}" /></button>
                                </div>
                            </div>
                        </g:HTMLPanel></t:content>
                    </t:DialogTab>
                </t:tab>
                <t:tab>
                    <t:DialogTab label="{constants.vmSecurityFileShareTab}">
                        <t:content><g:HTMLPanel styleName="{style.content}">
                            <h4><ui:text from="{constants.vmSecurityFileShareTab}" /></h4>
                            <div class="{style.sectionTitle}">1. <ui:text from="{constants.vmSecurityWindowsShare}" /></div>
                            <g:CheckBox styleName="{style.checkRow}" text="{constants.vmSecurityBlockInternalShare}" />
                            <g:CheckBox styleName="{style.checkRow}" text="{constants.vmSecurityDisableRemoteShare}" />
                            <div class="{style.sectionTitle}">2. <ui:text from="{constants.vmSecurityLinuxShare}" /></div>
                            <div class="{style.columns}">
                                <div class="{style.column}"><g:CheckBox styleName="{style.checkRow}" text="{constants.vmSecurityNfsBlock}" /><g:CheckBox styleName="{style.checkRow}" text="{constants.vmSecurityNfsAllow}" /></div>
                                <div class="{style.column}"><g:CheckBox styleName="{style.checkRow}" text="{constants.vmSecuritySambaBlock}" /><g:CheckBox styleName="{style.checkRow}" text="{constants.vmSecuritySambaAllow}" /></div>
                            </div>
                            <button class="btn btn-default"><ui:text from="{constants.vmSecurityAdd}" /></button>
                        </g:HTMLPanel></t:content>
                    </t:DialogTab>
                </t:tab>
                <t:tab>
                    <t:DialogTab label="{constants.vmSecurityWhitelistTab}">
                        <t:content><g:HTMLPanel styleName="{style.content}">
                            <g:TextBox ui:field="vmId" styleName="{style.hidden}" />
                            <div class="{style.toolbar}"><g:TextBox ui:field="guestCommandPath" styleName="form-control {style.toolbarInput}" text="C:\ovirt-security\scripts\security-control.bat" /><g:Button text="{constants.vmSecurityDelete}" /><g:Button text="{constants.vmSecurityAddToList}" /></div>
                            <table class="table table-striped table-bordered {style.commandTable}"><thead><tr><th class="{style.commandColumn}"><ui:text from="{constants.vmSecurityWhitelistTab}" /></th><th><ui:text from="{constants.vmSecurityDescription}" /></th><th class="{style.iconColumn}"><ui:text from="{constants.vmSecurityEdit}" /></th><th class="{style.iconColumn}"><ui:text from="{constants.vmSecurityDelete}" /></th></tr></thead>
                                <tbody><tr><td>/usr/bin/python3</td><td>Python Interpreter</td><td>✎</td><td>×</td></tr><tr><td>ls -la</td><td>List all files</td><td>✎</td><td>×</td></tr><tr><td>service nginx start</td><td>Start web server</td><td>✎</td><td>×</td></tr></tbody></table>
                            <g:Button ui:field="executeGuestCommandButton" styleName="btn btn-primary" text="{constants.vmSecurityExecuteCommand}" />
                            <h4><ui:text from="{constants.vmSecurityCommandResult}" /></h4><g:TextArea ui:field="guestCommandResult" styleName="form-control {style.result}" visibleLines="5" readOnly="true" />
                        </g:HTMLPanel></t:content>
                    </t:DialogTab>
                </t:tab>
                <t:tab>
                    <t:DialogTab label="{constants.vmSecurityInfoTab}">
                        <t:content><g:HTMLPanel styleName="{style.content}">
                            <div class="{style.toolbar}"><g:TextBox styleName="form-control {style.toolbarInput}" text="{constants.vmSecurityFilter}" /><span>◷ <ui:text from="{constants.vmSecurityRealtimeMonitoring}" /></span></div>
                            <table class="table table-striped table-bordered"><thead><tr><th><ui:text from="{constants.vmSecurityTime}" /></th><th><ui:text from="{constants.vmSecurityEventType}" /></th><th><ui:text from="{constants.vmSecurityStatus}" /></th><th><ui:text from="{constants.vmSecurityMessage}" /></th></tr></thead>
                                <tbody><tr><td>[10:42:01 AM]</td><td><ui:text from="{constants.vmSecurityNetworkTab}" /></td><td class="{style.eventOk}">[OK]</td><td>IP 192.168.1.50 applied.</td></tr><tr><td>[10:42:05 AM]</td><td><ui:text from="{constants.vmSecurityFileShareTab}" /></td><td class="{style.eventWarn}">[WARN]</td><td>Remote share denied.</td></tr><tr><td>[10:42:10 AM]</td><td>Command</td><td class="{style.eventWarn}">[NOTICE]</td><td>Command blocked: not whitelisted.</td></tr></tbody></table>
                            <p><ui:text from="{constants.vmSecurityInfoDescription}" /></p>
                        </g:HTMLPanel></t:content>
                    </t:DialogTab>
                </t:tab>
            </t:DialogTabPanel>
        </d:content>
        <d:footerButton><d:SimpleDialogButton ui:field="closeButton" text="{constants.closeButtonLabel}" /></d:footerButton>
        <d:footerButton><d:SimpleDialogButton ui:field="applyButton" text="{constants.vmSecurityApply}" /></d:footerButton>
    </d:SimpleDialogPanel>
</ui:UiBinder>
