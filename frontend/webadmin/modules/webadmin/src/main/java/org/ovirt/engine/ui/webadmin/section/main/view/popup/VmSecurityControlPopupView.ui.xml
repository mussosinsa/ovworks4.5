<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder
    xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:g="urn:import:com.google.gwt.user.client.ui"
    xmlns:d="urn:import:org.ovirt.engine.ui.common.widget.dialog"
    xmlns:t="urn:import:org.ovirt.engine.ui.common.widget.dialog.tab">

    <ui:with field="constants" type="org.ovirt.engine.ui.webadmin.ApplicationConstants" />

    <ui:style>
        .content { height: 100%; overflow: auto; padding: 18px 20px; box-sizing: border-box; }
        .formRow { margin-bottom: 10px; }
        .formLabel { display: block; font-weight: 600; margin-bottom: 4px; }
        .fullWidth { width: 100%; box-sizing: border-box; }
        .actionRow { margin-top: 14px; }
        .hint { color: #666; margin: 8px 0 12px; }
        .result { width: 100%; min-height: 105px; box-sizing: border-box; font-family: monospace; }
        .hidden { display: none; }
        .columns { display: flex; gap: 32px; }
        .column { flex: 1; min-width: 0; }
        .divider { border-left: 1px solid #ddd; padding-left: 24px; }
        .sectionTitle { background: #edf6fc; font-weight: 700; padding: 4px 6px; margin: 8px 0; }
        .checkRow { display: block; margin: 6px 0; }
        .toolbar { display: flex; gap: 8px; margin-bottom: 10px; }
        .toolbarInput { flex: 1; min-width: 0; }
        .commandTable { table-layout: fixed; width: 100%; }
        .commandColumn { width: 35%; }
        .iconColumn { width: 54px; text-align: center; }
        .eventOk { color: #238b45; }
        .eventWarn { color: #bd8b00; }
    </ui:style>

    <d:SimpleDialogPanel header="{constants.vmSecurityControlTitle}" height="560px" width="880px">
        <d:content>
            <t:DialogTabPanel height="100%" width="100%">
                <t:tab>
                    <t:DialogTab label="{constants.vmSecurityNetworkTab}">
                        <t:content><g:HTMLPanel styleName="{style.content}">
                            <div class="{style.columns}">
                                <div class="{style.column}">
                                    <label class="{style.formLabel}"><ui:text from="{constants.vmSecurityNetworkAdapter}" /></label>
                                    <div class="{style.toolbar}">
                                        <g:ListBox ui:field="networkAdapter" styleName="form-control {style.toolbarInput}" visibleItemCount="1" />
                                        <g:Button ui:field="refreshNetworkAdaptersButton" styleName="btn btn-default" text="{constants.vmSecurityRefreshAdapters}" />
                                    </div>
                                    <h4><ui:text from="{constants.vmSecurityStatusSettings}" /></h4>
                                    <g:RadioButton ui:field="disableNetworkRadioButton" name="vmSecurityNetworkStatus" styleName="{style.checkRow}" text="{constants.vmSecurityDisable}" />
                                    <g:RadioButton ui:field="enableNetworkRadioButton" name="vmSecurityNetworkStatus" styleName="{style.checkRow}" text="{constants.vmSecurityEnableIp}" value="true" />
                                    <g:Button ui:field="applyNetworkSettingsButton" styleName="btn btn-success" text="{constants.vmSecurityTestAndSave}" />
                                    <g:Label ui:field="networkSettingsResult" />
                                </div>
                                <g:HTMLPanel ui:field="ipDetailsPanel" styleName="{style.column} {style.divider}">
                                    <h4><ui:text from="{constants.vmSecurityIpDetails}" /></h4>
                                    <div class="{style.formRow}"><label><ui:text from="{constants.vmSecurityIpAddress}" /></label><g:TextBox ui:field="ipAddress" styleName="form-control {style.fullWidth}" text="192.168.1.50" /></div>
                                    <div class="{style.formRow}"><label><ui:text from="{constants.vmSecuritySubnetMask}" /></label><g:TextBox ui:field="subnetMask" styleName="form-control {style.fullWidth}" text="255.255.255.0" /></div>
                                    <div class="{style.formRow}"><label><ui:text from="{constants.vmSecurityGateway}" /></label><g:TextBox ui:field="gateway" styleName="form-control {style.fullWidth}" text="192.168.1.1" /></div>
                                    <div class="{style.formRow}"><label><ui:text from="{constants.vmSecurityDnsServer}" /></label><g:TextBox styleName="form-control {style.fullWidth}" text="8.8.8.8" /></div>
                                </g:HTMLPanel>
                            </div>
                        </g:HTMLPanel></t:content>
                    </t:DialogTab>
                </t:tab>
                <t:tab>
                    <t:DialogTab label="{constants.vmSecurityFileShareTab}">
                        <t:content><g:HTMLPanel styleName="{style.content}">
                            <h4><ui:text from="{constants.vmSecurityFileShareTab}" /></h4>
                            <div class="{style.sectionTitle}">1. <ui:text from="{constants.vmSecurityWindowsShare}" /></div>
                            <g:RadioButton ui:field="blockFileSharingRadioButton" name="vmSecurityWindowsSharePolicy" styleName="{style.checkRow}" text="{constants.vmSecurityBlockInternalShare}" value="true" />
                            <g:RadioButton name="vmSecurityWindowsSharePolicy" styleName="{style.checkRow}" text="{constants.vmSecurityDisableRemoteShare}" />
                            <g:Button ui:field="applyFileSharingSettingsButton" styleName="btn btn-success" text="{constants.vmSecurityApply}" />
                            <g:Label ui:field="fileSharingSettingsResult" />
                            <div class="{style.sectionTitle}">2. <ui:text from="{constants.vmSecurityLinuxShare}" /></div>
                            <div class="{style.columns}">
                                <div class="{style.column}"><g:CheckBox styleName="{style.checkRow}" text="{constants.vmSecurityNfsBlock}" /><g:CheckBox styleName="{style.checkRow}" text="{constants.vmSecurityNfsAllow}" /></div>
                                <div class="{style.column}"><g:CheckBox styleName="{style.checkRow}" text="{constants.vmSecuritySambaBlock}" /><g:CheckBox styleName="{style.checkRow}" text="{constants.vmSecuritySambaAllow}" /></div>
                            </div>
                        </g:HTMLPanel></t:content>
                    </t:DialogTab>
                </t:tab>
                <t:tab>
                    <t:DialogTab label="{constants.vmSecurityWhitelistTab}">
                        <t:content><g:HTMLPanel styleName="{style.content}">
                            <g:TextBox ui:field="vmId" styleName="{style.hidden}" />
                            <div class="{style.sectionTitle}">1. <ui:text from="{constants.vmSecurityWhitelistTab}" /></div>
                            <p><ui:text from="{constants.vmSecurityWhitelistHelp}" /></p>
                            <g:RadioButton ui:field="enableAppLockerRadioButton" name="vmSecurityAppLockerPolicy" styleName="{style.checkRow}" text="{constants.vmSecurityWhitelistEnable}" value="true" />
                            <g:RadioButton name="vmSecurityAppLockerPolicy" styleName="{style.checkRow}" text="{constants.vmSecurityWhitelistDisable}" />
                            <label class="{style.formLabel}"><ui:text from="{constants.vmSecurityAllowedFolder}" /></label>
                            <g:TextBox ui:field="guestCommandPath" styleName="form-control {style.fullWidth}" text="C:\AllowedApps\*" />
                            <g:Button ui:field="executeGuestCommandButton" styleName="btn btn-primary {style.actionRow}" text="{constants.vmSecurityApply}" />
                            <div class="{style.sectionTitle}">2. <ui:text from="{constants.vmSecurityManagementBlockTitle}" /></div>
                            <p><ui:text from="{constants.vmSecurityManagementBlockHelp}" /></p>
                            <g:RadioButton ui:field="blockManagementCommandsRadioButton" name="vmSecurityManagementPolicy" styleName="{style.checkRow}" text="{constants.vmSecurityManagementBlockEnable}" value="true" />
                            <g:RadioButton name="vmSecurityManagementPolicy" styleName="{style.checkRow}" text="{constants.vmSecurityManagementBlockDisable}" />
                            <g:Button ui:field="applyManagementBlockButton" styleName="btn btn-success" text="{constants.vmSecurityApply}" />
                            <g:Label ui:field="managementBlockResult" />
                            <h4><ui:text from="{constants.vmSecurityCommandResult}" /></h4><g:TextArea ui:field="guestCommandResult" styleName="form-control {style.result}" visibleLines="5" readOnly="true" />
                        </g:HTMLPanel></t:content>
                    </t:DialogTab>
                </t:tab>
                <t:tab>
                    <t:DialogTab label="{constants.vmSecurityInfoTab}">
                        <t:content><g:HTMLPanel styleName="{style.content}">
                            <div class="{style.toolbar}">
                                <g:TextBox ui:field="eventFilter" styleName="form-control {style.toolbarInput}" />
                                <g:Button ui:field="refreshGuestEventsButton" styleName="btn btn-default" text="{constants.vmSecurityLoadEvents}" />
                                <span>◷ <ui:text from="{constants.vmSecurityRealtimeMonitoring}" /></span>
                            </div>
                            <g:FlexTable ui:field="guestEventTable" styleName="table table-striped table-bordered {style.fullWidth}" />
                            <g:Label ui:field="guestEventsMessage" styleName="{style.hint}" />
                            <p><ui:text from="{constants.vmSecurityInfoDescription}" /></p>
                        </g:HTMLPanel></t:content>
                    </t:DialogTab>
                </t:tab>
            </t:DialogTabPanel>
        </d:content>
        <d:footerButton><d:SimpleDialogButton ui:field="closeButton" text="{constants.closeButtonLabel}" /></d:footerButton>
    </d:SimpleDialogPanel>
</ui:UiBinder>
