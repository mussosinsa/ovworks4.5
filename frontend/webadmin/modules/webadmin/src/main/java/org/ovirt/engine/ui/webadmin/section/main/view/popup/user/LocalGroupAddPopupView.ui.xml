 xmlns:g="urn:import:com.google.gwt.user.client.ui">

 <ui:style>
  .hint { color: #6a6e73; font-size: 12px; line-height: 1.7; margin: -6px 0 10px; }
 </ui:style>

 <d:SimpleDialogPanel width="520px" height="240px"><d:content><b:Container fluid="true">
