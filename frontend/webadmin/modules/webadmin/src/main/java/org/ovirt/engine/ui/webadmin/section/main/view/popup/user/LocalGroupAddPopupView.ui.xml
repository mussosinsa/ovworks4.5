  <b:Row>
   <b:Column size="SM_8" offset="SM_4">
    <g:HTMLPanel styleName="{style.hint}">
     영문, 숫자, 점(.), 밑줄(_), 붙임표(-) 만 쓸 수 있습니다.
    </g:HTMLPanel>
   </b:Column>
  </b:Row>
 </b:Container></d:content></d:SimpleDialogPanel>
</ui:UiBinder>
