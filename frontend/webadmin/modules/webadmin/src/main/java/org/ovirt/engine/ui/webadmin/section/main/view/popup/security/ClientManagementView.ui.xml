<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder
    xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:g="urn:import:com.google.gwt.user.client.ui"
    xmlns:b="urn:import:org.gwtbootstrap3.client.ui">

    <ui:with field="constants" type="org.ovirt.engine.ui.webadmin.ApplicationConstants" />

    <ui:style>
        .mainPanel {
            padding: 20px;
            width: 100%;
        }

        .sectionPanel {
            margin-top: 20px;
            margin-bottom: 20px;
            padding: 15px;
            border: 1px solid #ddd;
            border-radius: 4px;
        }

        .sectionTitle {
            font-size: 18px;
            font-weight: bold;
            margin-bottom: 15px;
        }

        .inputPanel {
            margin-top: 15px;
            display: flex;
            align-items: center;
        }

        .inputField {
            flex: 1;
            margin-right: 15px;
        }

        .actionButton {
            min-width: 100px;
        }

        .numberBadge {
            background-color: #337ab7;
            color: white;
            border-radius: 50%;
            width: 30px;
            height: 30px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            margin-left: 15px;
        }

        .ipTextarea {
            min-height: 70px;
        }
    </ui:style>

    <g:FlowPanel addStyleNames="{style.mainPanel}">
        <!-- Terminal Authentication Section -->
        <g:FlowPanel addStyleNames="{style.sectionPanel}">
            <g:HTML addStyleNames="{style.sectionTitle}">
                단말기 인증
            </g:HTML>

            <g:HorizontalPanel addStyleNames="{style.inputPanel}">
                <b:TextBox ui:field="terminalAuthInput"
                          placeholder="단말기 일련번호를 입력하세요"
                          addStyleNames="{style.inputField}" />
                <b:Button ui:field="terminalAuthButton"
                          text="적용"
                          type="PRIMARY"
                          addStyleNames="{style.actionButton}" />
                <g:HTML addStyleNames="{style.numberBadge}">1</g:HTML>
            </g:HorizontalPanel>

            <g:HTML>
                <div style="margin-top: 10px; font-size: 12px; color: #666;">
                    /etc/ovirt-engine/encryptor/config.json 파일의 serialNum 필드에 적용됩니다
                </div>
            </g:HTML>
        </g:FlowPanel>

        <!-- Terminal IP Authentication Section -->
        <g:FlowPanel addStyleNames="{style.sectionPanel}">
            <g:HTML addStyleNames="{style.sectionTitle}">
                단말기 IP 인증
            </g:HTML>

            <g:HorizontalPanel addStyleNames="{style.inputPanel}">
                <b:TextArea ui:field="terminalIpInput"
                            placeholder="192.168.1.100"
                            addStyleNames="{style.inputField} {style.ipTextarea}" />
                <b:Button ui:field="terminalIpButton"
                          text="적용"
                          type="PRIMARY"
                          addStyleNames="{style.actionButton}" />
                <g:HTML addStyleNames="{style.numberBadge}">2</g:HTML>
            </g:HorizontalPanel>

            <g:HTML>
                <div style="margin-top: 10px; font-size: 12px; color: #666;">
                    IP 주소를 한 줄에 하나씩 입력하면 /etc/httpd/conf.d/z-ovirt-engine-proxy.conf 파일의
                    &lt;RequireAll&gt; 내부에 Require ip 항목으로 적용됩니다. CIDR/대역은 허용되지 않습니다.
                </div>
            </g:HTML>

        </g:FlowPanel>
    </g:FlowPanel>
</ui:UiBinder>
