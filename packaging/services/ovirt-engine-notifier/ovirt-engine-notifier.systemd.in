# Modified by 새올정보기술 for OV-Works (2026). Changes against oVirt Engine 4.5.6: docs/ovworks-source-change-statement.md
[Unit]
Description=oVirt Engine Notifier
After=network.target @POSTGRESQL_SYSTEMD_SERVICE@ ovirt-engine-kek-agent.service
Wants=ovirt-engine-kek-agent.service

[Service]
Type=notify
User=@ENGINE_USER@
Group=@ENGINE_GROUP@
ExecStart=@ENGINE_USR@/services/ovirt-engine-notifier/ovirt-engine-notifier.py --redirect-output --systemd=notify $EXTRA_ARGS start
EnvironmentFile=-/etc/sysconfig/ovirt-engine-notifier

[Install]
WantedBy=multi-user.target
