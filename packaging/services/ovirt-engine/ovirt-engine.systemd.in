[Unit]
Description=oVirt Engine
After=network.target @POSTGRESQL_SYSTEMD_SERVICE@

[Service]
Type=notify
User=@ENGINE_USER@
Group=@ENGINE_GROUP@
LimitNOFILE=65535
# Invoke the packaged service through the trusted system Python executable.
# Executing the Python source directly can be denied by SELinux when a locally
# built package leaves the source file with a generic data-file context.
ExecStart=/usr/bin/python@PY_VERSION@ @ENGINE_USR@/services/ovirt-engine/ovirt-engine.py --redirect-output --systemd=notify $EXTRA_ARGS start
EnvironmentFile=-/etc/sysconfig/ovirt-engine

[Install]
WantedBy=multi-user.target
