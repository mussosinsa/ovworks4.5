
PKIDIR="@ENGINE_PKI@"
USRDIR="@ENGINE_USR@"
BINDIR="${USRDIR}/bin"
ENGINE_CA="ca"
QEMU_CA="qemu-ca"

# The engine's PKI keys come from a Hash_DRBG over SHA-256, as every other
# secret of the engine does, rather than OpenSSL's default CTR-DRBG over AES.
# Not in FIPS mode, where the system configuration's FIPS provider supplies the
# approved generator and replacing that configuration would drop it. Not either
# when this OpenSSL cannot read the file: the commands then run as they always
# did instead of failing.
common_use_engine_drbg() {
	local conf="${USRDIR}/conf/openssl-drbg.cnf"
	[ -r "${conf}" ] || return 0
	[ "$(cat /proc/sys/crypto/fips_enabled 2>/dev/null)" = "1" ] && return 0
	OPENSSL_CONF="${conf}" openssl version > /dev/null 2>&1 || return 0
	export OPENSSL_CONF="${conf}"
}
common_use_engine_drbg

die() {
	local m="$1"
	echo "$m" >&2
	exit 1
}

common_backup() {
	local time="$(date +"%Y%m%d%H%M%S")"

	while [ -n "$1" ]; do
		local f="$1"
		shift
		if [ -f "${f}" ]; then
			cp -a "${f}" "${f}.${time}" || \
				die "Failed to backup ${f}"
		fi
	done
}

common_restore_perms() {
	local pkidir="$1"

	# openssl always reset ownership
	# of these files, so we have to reset
	# our defaults
	chown --reference="${pkidir}" "${pkidir}"/serial.txt* "${pkidir}"/database.txt* "${pkidir}"/.rnd* > /dev/null 2>&1
}

common_set_conf_vars() {
	# Set {CACERT,CERT}_{TEMPLATE,CONF} based on value of CA_FILE
	if [ "${CA_FILE}" == "${ENGINE_CA}" ]; then
		CERT_CONF="cert.conf"
		CACERT_CONF="cacert.conf"
		CERT_TEMPLATE="cert.template"
		CACERT_TEMPLATE="cacert.template"
	elif [ "${CA_FILE}" == "${QEMU_CA}" ]; then
		CERT_CONF="qemu-cert.conf"
		CACERT_CONF="qemu-cacert.conf"
		CERT_TEMPLATE="qemu-cert.template"
		CACERT_TEMPLATE="qemu-cacert.template"
	else
		die "Unknown CA file"
	fi
}
