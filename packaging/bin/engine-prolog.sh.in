
export ENGINE_DEFAULTS="${ENGINE_DEFAULTS:-@ENGINE_DEFAULTS@}"
export ENGINE_VARS="${ENGINE_VARS:-@ENGINE_VARS@}"
PACKAGE_NAME="@PACKAGE_NAME@"
PACKAGE_VERSION="@PACKAGE_VERSION@"
DISPLAY_VERSION="@DISPLAY_VERSION@"
ENGINE_LOG="@ENGINE_LOG@"

# We need to disable FIPS configuration of OpenJDK to be able to work with
# file system keystores and interoperability with openssl
export JAVA_TOOL_OPTIONS="-Dcom.redhat.fips=false"

die() {
	local m="$1"
	echo "FATAL: ${m}" >&2
	exit 1
}

load_config() {

	local prolog_path="${BASH_SOURCE[0]:-$0}"
	local installed_engine_usr
	installed_engine_usr="$(cd "$(dirname "${prolog_path}")/.." && pwd -P)"
	local installed_engine_defaults="${installed_engine_usr}/services/ovirt-engine/ovirt-engine.conf"
	if [ ! -r "${ENGINE_DEFAULTS}" ] && [ -r "${installed_engine_defaults}" ]; then
		echo "WARNING: Ignoring malformed ENGINE_DEFAULTS '${ENGINE_DEFAULTS}'; using '${installed_engine_defaults}'." >&2
		ENGINE_DEFAULTS="${installed_engine_defaults}"
		export ENGINE_DEFAULTS
	fi

	[ -r "${ENGINE_DEFAULTS}" ] || die "Can't load defaults file \"${ENGINE_DEFAULTS}\"."

	for f in \
		"${ENGINE_DEFAULTS}" \
		"${ENGINE_VARS}" \
		$([ -d "${ENGINE_VARS}.d" ] && find "${ENGINE_VARS}.d" -name '*.conf' | sort) \
		; do

		[ -r "${f}" ] || continue
		# Authenticated configuration envelopes are consumed and decrypted by
		# the Java/Python configuration readers.  They are binary data, not shell
		# assignments, and sourcing one can also leave a misleading unmatched
		# quote error when the ciphertext happens to contain an apostrophe.
		config_magic="$(LC_ALL=C dd if="${f}" bs=8 count=1 2>/dev/null)"
		case "${config_magic}" in
			OVENC001|OVENC002|OVVLT001) continue ;;
		esac
		. "${f}"
	done

	[ -n "${OVIRT_JBOSS_HOME}" ] && JBOSS_HOME="${OVIRT_JBOSS_HOME}"

	if [ ! -x "${ENGINE_USR}/bin/java-home" ]; then
		if [ -x "${installed_engine_usr}/bin/java-home" ]; then
			echo "WARNING: Ignoring malformed ENGINE_USR '${ENGINE_USR}'; using '${installed_engine_usr}'." >&2
			ENGINE_USR="${installed_engine_usr}"
			export ENGINE_USR
		fi
	fi

	JAVA_HOME="$("${ENGINE_USR}/bin/java-home")" || die "Cannot set JAVA_HOME"
	export JAVA_HOME

	# we use jboss specific loader (jboss-modules.jar)
	# setup module path
	export JAVA_MODULEPATH="${ENGINE_USR}/modules/tools:${ENGINE_JAVA_MODULEPATH}:${JBOSS_HOME}/modules"

	# clean the class path
	# jboss module loader will not run otherwise.
	export CLASSPATH=""
}

# Hands a Java tool that reads the engine configuration itself (engine-config, the SSO client
# registration tool) the values of the encrypted part of it.
#
# The Java configuration loader skips encrypted files, and the database connection settings
# (10-setup-database.conf) are encrypted: such a tool then connects with no URL, user or
# password and reports the database as unreachable. They are decrypted here the way the engine's
# own start and the notifier do it, and the whole configuration is handed over as one file -
# ENGINE_VARS - in a private directory (0700, the file 0600) removed when the tool ends.
# With nothing encrypted, nothing changes. The tool must then be run, not exec'ed, for the
# directory to be removed.
use_decrypted_engine_config() {
	local tool="$1"
	local python="${ENGINE_TOOL_PYTHON:-python3}"
	local dir status

	if ! "${python}" - "${ENGINE_DEFAULTS}" "${ENGINE_VARS}" >/dev/null 2>&1 <<'PY'
import sys
from ovirt_engine import configfile
sys.exit(0 if configfile.encrypted_files(sys.argv[1:]) else 1)
PY
	then
		return 0
	fi

	dir="$(umask 077; mktemp -d "${ENGINE_TOOL_RUNTIME:-/run}/ovirt-engine-tool.XXXXXXXX" 2>/dev/null || mktemp -d)" \
		|| die "Cannot create a private directory for the decrypted engine configuration."
	chmod 0700 "${dir}"
	ENGINE_TOOL_RUNTIME_DIR="${dir}"
	trap 'rm -rf "${ENGINE_TOOL_RUNTIME_DIR}"' EXIT
	trap 'exit 130' INT
	trap 'exit 143' TERM HUP

	if ! status="$("${python}" - "${ENGINE_DEFAULTS}" "${ENGINE_VARS}" "${dir}/engine.conf" "${tool}" <<'PY'
import sys
from ovirt_engine import configfile
defaults, engine_vars, target, tool = sys.argv[1:]
try:
    config = configfile.ConfigFile((defaults, engine_vars), cryptoEventSource=tool)
    configfile.write_shell_config(config.values, target)
except Exception as error:  # pylint: disable=broad-except
    print(str(error).replace("\n", " "))
    sys.exit(1)
PY
	)"; then
		die "The engine configuration could not be decrypted (${status}). Check that the KEK passphrase is held in memory: python3 /usr/share/ovirt-engine/encryptor/kek_agent.py --status"
	fi
	ENGINE_VARS="${dir}/engine.conf"
	export ENGINE_VARS
}

load_config
