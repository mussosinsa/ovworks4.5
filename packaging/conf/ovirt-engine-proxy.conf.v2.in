#
# The name of this file name is very important, the "z-" prefix is used
# to force the web server to load this file after all the other
# configurations, in particular after the configuration of the required
# proxy modules, otherwise the "IfModule" directives fail.
#

<IfModule !proxy_ajp_module>
    # If you get an error in this block, it means that proxy_ajp_module is not:
    # 1. loaded by other configuration of httpd
    # 2. found in the path below (which is relative to ServerRoot)
    LoadModule proxy_ajp_module modules/mod_proxy_ajp.so
</IfModule>

<IfModule proxy_ajp_module>

<IfModule log_config_module>
    # Audit log for denied access to the engine (e.g., blocked by the Require ip rules below).
    # Captures denied client IP, request line, status and user-agent for traceability.
    #
    # Every /ovirt-engine URI is covered, not the admin page alone: the Require ip block guards
    # the whole of it, so an address that is not registered is turned away from the REST API and
    # the login page too, and those attempts are the ones worth seeing.
    #
    # ClientAccessDeniedAuditManager reads this file and puts each line in the engine's event
    # list. Its format is that reader's input - a change here needs the same change there.
    LogFormat "time=%{%Y-%m-%dT%H:%M:%S%z}t remote_ip=%a request=\"%r\" status=%>s referer=\"%{Referer}i\" user_agent=\"%{User-agent}i\"" ovirt_admin_access_denied_audit
    CustomLog "/var/log/httpd/ovirt-engine-admin-access-denied-audit.log" ovirt_admin_access_denied_audit "expr=(%{REQUEST_STATUS} == 403) && (%{REQUEST_URI} =~ m#^/ovirt-engine#)"
</IfModule>

    #
    # Remove the Expect headers from API requests (this is needed to fix a
    # problem with some API clients):
    #
    # This is required because otherwise Expect header, which is hop-by-hop
    # will be caught by the Apache and will NOT be forwared to the proxy.
    #
    # It currenly is used here, which means GLOBALLY for the server. It is done
    # this way because RequestHeader 'early' doesn't allow using in either
    # 'Directory' or 'Location' nested clauses.
    #
    # TODO: find a way to filter Expect headers for /api name space only.
    <IfModule headers_module>
        RequestHeader unset Expect early
    </IfModule>

    #
    # What an administrator sees while the engine is not running.
    #
    # The self-test is a gate: a start whose verification does not pass does not happen, and an
    # engine that is not running serves nothing. So the response to a failed verification - the
    # service is stopped - could not be seen on any screen; the browser showed the web server's
    # own "Service Unavailable", which says nothing about security and reads like a network
    # fault. This is the screen for it, served from disk by the web server, which stays up while
    # the engine does not.
    #
    # Not under /ovirt-engine: that prefix is proxied to the engine, and a page for the case
    # where the engine is down cannot be one the engine has to serve. It carries the same address
    # list all the same, so the halt is shown to the terminals that are allowed to ask and to
    # nobody else - a request that got the 503 has already passed that list.
    #
    Alias /ovirt-engine-service-halted.html "@ENGINE_SERVICE_HALTED_PAGE@"

    # A directory of its own, holding this page and nothing else. Granting the whole of
    # <engine data>/conf would put every template and defaults file in it on the web server too.
    <Directory "@ENGINE_SERVICE_HALTED_DIR@">
        <RequireAny>
@CLIENT_CONTROL_REQUIRE_IPS@
        </RequireAny>
    </Directory>

    <LocationMatch ^/ovirt-engine($|/)>
        ProxyPassMatch ajp://127.0.0.1:@JBOSS_AJP_PORT@ timeout=3600 retry=5

        # Every 503 from the proxy above, which is what an engine that is not running produces.
        ErrorDocument 503 /ovirt-engine-service-halted.html

        # Only the terminals listed here may reach the engine. "Require all granted"
        # used to stand at the head of this block, and being unconditional it matched
        # first, so every address was allowed whatever the list below said - the list
        # read as a restriction while restricting nothing. It is gone for that reason.
        # The list is never written empty: see TerminalIpConfigUtils, which refuses to
        # leave this block with nothing in it, and always keeps 127.0.0.1 on it.
        <RequireAny>
@CLIENT_CONTROL_REQUIRE_IPS@
        </RequireAny>

        <IfModule deflate_module>
            AddOutputFilterByType DEFLATE text/javascript text/css text/html text/xml text/json application/xml application/json application/x-yaml
        </IfModule>
    </LocationMatch>

</IfModule>
