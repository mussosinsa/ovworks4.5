<web-app xmlns="http://java.sun.com/xml/ns/javaee" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-app_3_0.xsd"
    version="3.0">

    <context-param>
        <param-name>resteasy.media.type.param.mapping</param-name>
        <param-value>accept</param-value>
    </context-param>

    <filter>
        <filter-name>CORSSupport</filter-name>
        <filter-class>org.ovirt.engine.core.utils.servlet.CORSSupportFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>CORSSupport</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <filter>
        <filter-name>CSRFProtection</filter-name>
        <filter-class>org.ovirt.engine.api.restapi.security.CSRFProtectionFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>CSRFProtection</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- Answers POST /ovirt-engine/api/logout and stops there. It is mapped after the CSRF filter,
         so a session that asked for that protection keeps it, and before the filters that would
         drop the HTTP session and authenticate the request again, which would leave the session
         the client asked to end still open. -->
    <filter>
        <filter-name>RestApiLogoutFilter</filter-name>
        <filter-class>org.ovirt.engine.core.aaa.filters.RestApiLogoutFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>RestApiLogoutFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- Answers GET /ovirt-engine/api/session and stops there. Mapped, like the logout filter,
         ahead of the filters that authenticate a request and of the one that drops the HTTP session
         of a session that has ended: it needs to read the session id those would have removed, and
         it must not be able to log a client in - a client polls this to find out that its session
         is over, so the poll creating a new session would defeat the whole of it. -->
    <filter>
        <filter-name>RestApiSessionStatusFilter</filter-name>
        <filter-class>org.ovirt.engine.core.aaa.filters.RestApiSessionStatusFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>RestApiSessionStatusFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <filter>
        <filter-name>RestApiSessionValidationFilter</filter-name>
        <filter-class>org.ovirt.engine.core.aaa.filters.RestApiSessionValidationFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>RestApiSessionValidationFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <filter>
        <filter-name>SessionValidationFilter</filter-name>
        <filter-class>org.ovirt.engine.core.aaa.filters.SessionValidationFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>SessionValidationFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- Refuses a request presenting the session id of a session already ended. Mapped after the
         filters that drop the HTTP session of an ended session and before the ones that
         authenticate: that is the only window in which the request no longer resolves to a session
         and nothing has yet given it a new one. Put it after SsoRestApiAuthFilter and a replayed
         request carrying credentials would have logged itself in again before being looked at. -->
    <filter>
        <filter-name>RestApiReplayGuardFilter</filter-name>
        <filter-class>org.ovirt.engine.core.aaa.filters.RestApiReplayGuardFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>RestApiReplayGuardFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <filter>
        <filter-name>SsoRestApiAuthFilter</filter-name>
        <filter-class>org.ovirt.engine.core.aaa.filters.SsoRestApiAuthFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>SsoRestApiAuthFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <filter>
        <filter-name>SsoRestApiNegotiationFilter</filter-name>
        <filter-class>org.ovirt.engine.core.aaa.filters.SsoRestApiNegotiationFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>SsoRestApiNegotiationFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <filter>
        <filter-name>EnforceAuthFilter</filter-name>
        <filter-class>org.ovirt.engine.core.aaa.filters.EnforceAuthFilter</filter-class>
        <!-- schemes parameter names should be in format of scheme.XXX Add
            an init-param per each scheme -->
        <init-param>
            <param-name>scheme.basic_auth</param-name>
            <param-value>Basic realm="RESTAPI"</param-value>
        </init-param>
    </filter>
    <filter-mapping>
        <filter-name>EnforceAuthFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <filter>
        <filter-name>RestApiSessionMgmtFilter</filter-name>
        <filter-class>org.ovirt.engine.core.aaa.filters.RestApiSessionMgmtFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>RestApiSessionMgmtFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <filter>
        <filter-name>CurrentFilter</filter-name>
        <filter-class>org.ovirt.engine.api.restapi.invocation.CurrentFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>CurrentFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <filter>
        <filter-name>VersionFilter</filter-name>
        <filter-class>org.ovirt.engine.api.restapi.invocation.VersionFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>VersionFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- This servlet will never be called because the version filter will always forward to "/v4", but
         without it the servlet container uses the 302 HTTP code to redirect "/ovirt-engine/api" to
         "/ovirt-engine/api/", and some clients (the SDKs) don't understand that. -->
    <servlet>
        <servlet-name>NullServlet</servlet-name>
        <servlet-class>org.ovirt.engine.api.restapi.NullServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>NullServlet</servlet-name>
        <url-pattern>/*</url-pattern>
    </servlet-mapping>

    <!-- The servlet that provides access to the model description: -->
    <servlet>
        <servlet-name>ModelServlet</servlet-name>
        <servlet-class>org.ovirt.api.metamodel.server.ModelServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ModelServlet</servlet-name>
        <url-pattern>/model</url-pattern>
        <url-pattern>/model.xml</url-pattern>
        <url-pattern>/model.json</url-pattern>
        <url-pattern>/model.jar</url-pattern>
        <url-pattern>/model.zip</url-pattern>
        <url-pattern>/model.html</url-pattern>
    </servlet-mapping>

    <!-- confidentiality -->
    <security-constraint>
        <web-resource-collection>
            <web-resource-name>everything</web-resource-name>
            <url-pattern>/*</url-pattern>
        </web-resource-collection>
        <user-data-constraint>
            <transport-guarantee>NONE</transport-guarantee>
        </user-data-constraint>
    </security-constraint>

    <session-config>
        <session-timeout>180</session-timeout>
        <cookie-config>
            <http-only>true</http-only>
            <secure>false</secure>
        </cookie-config>
    </session-config>

</web-app>
